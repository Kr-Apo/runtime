{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ankhimate:offline-bounded-qualification:1",
  "title": "ReplayV1 offline bounded qualification result (not a runtime permission)",
  "type": "object",
  "required": [
    "contract",
    "request",
    "requestHash",
    "status",
    "coverage",
    "tolerances",
    "maxima",
    "firstViolation",
    "violations",
    "nonfinite",
    "problems",
    "equivalence",
    "evidence",
    "exactDifferenceRows",
    "scope",
    "trust"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "ankhimate.replay.bounded/1"
    },
    "request": {
      "type": "object"
    },
    "requestHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "QUALIFIED_BOUNDED",
        "FAILED_NUMERICAL_PARITY",
        "FAILED_NONFINITE",
        "INVALID_INPUT",
        "INCOMPLETE_EVIDENCE"
      ]
    },
    "coverage": {
      "type": "object",
      "required": [
        "originTick",
        "horizon",
        "ticks",
        "histories",
        "families",
        "notComparedFamilies"
      ]
    },
    "tolerances": {
      "const": {
        "localTranslation": 0.01,
        "rotation": 0.001,
        "scaleShear": 0.0001,
        "worldLinear": 0.0001,
        "worldTranslation": 0.01,
        "angularVelocity": 0.001,
        "linearVelocity": 0.01,
        "anchor": 0.01,
        "tip": 0.01,
        "influenceWorld": 0.01,
        "vertexWorld": 0.01
      }
    },
    "maxima": {
      "type": "object"
    },
    "firstViolation": {
      "type": [
        "object",
        "null"
      ]
    },
    "violations": {
      "type": "integer",
      "minimum": 0
    },
    "nonfinite": {
      "type": "array"
    },
    "problems": {
      "type": "array"
    },
    "equivalence": {
      "type": "object"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "sha256",
          "bytes"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "exactDifferenceRows": {
      "type": "integer",
      "minimum": 0
    },
    "scope": {
      "type": "string"
    },
    "trust": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "QUALIFIED_BOUNDED"
          }
        }
      },
      "then": {
        "properties": {
          "nonfinite": {
            "maxItems": 0
          },
          "problems": {
            "maxItems": 0
          },
          "violations": {
            "const": 0
          },
          "evidence": {
            "required": [
              "asset.native.json",
              "rust.json",
              "typescript.json",
              "comparison.json",
              "errors.jsonl",
              "execution.json",
              "regenerated.native.json"
            ],
            "minProperties": 7,
            "maxProperties": 7
          }
        }
      }
    }
  ]
}
